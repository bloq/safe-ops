{
  "name": "@bloq/safe-ops",
  "version": "0.2.0",
  "description": "Queue, export, rehearse and propose owner transactions for Safe multisigs",
  "license": "MIT",
  "author": "Rohit Solia <rohit@bloq.com>",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.1.0",
  "files": [
    "dist",
    "hardhat"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./hardhat": {
      "import": {
        "types": "./dist/hardhat/index.d.ts",
        "default": "./dist/hardhat/index.js"
      },
      "require": {
        "types": "./dist/hardhat/index.d.cts",
        "default": "./dist/hardhat/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint --fix .",
    "test": "vitest run --project unit",
    "test:fork": "vitest run --project fork",
    "test:watch": "vitest --project unit"
  },
  "dependencies": {
    "@safe-global/safe-deployments": "1.37.63"
  },
  "peerDependencies": {
    "viem": "^2.57.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@safe-global/protocol-kit": "^8.0.7",
    "@safe-global/types-kit": "^4.0.1",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "viem": "^2.57.0",
    "vitest": "^5.0.2"
  }
}
